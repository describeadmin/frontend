{
  "name": "@describeadmin/stores",
  "version": "0.1.0",
  "homepage": "https://github.com/describeadmin/frontend",
  "bugs": "https://github.com/describeadmin/frontend/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/describeadmin/frontend.git",
    "directory": "packages/stores"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm exec tsdown",
    "stub": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "production": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "@describeadmin/core-preferences": "workspace:*",
    "@describeadmin/core-shared": "workspace:*",
    "@describeadmin/core-typings": "workspace:*",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "secure-ls": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
