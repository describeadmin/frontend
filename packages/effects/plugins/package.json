{
  "name": "@describeadmin/plugins",
  "version": "0.1.0",
  "homepage": "https://github.com/describeadmin/frontend",
  "bugs": "https://github.com/describeadmin/frontend/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/describeadmin/frontend.git",
    "directory": "packages/effects/plugins"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm exec tsdown",
    "stub": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "production": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./echarts": {
      "types": "./src/echarts/index.ts",
      "development": "./src/echarts/index.ts",
      "production": "./src/echarts/index.ts",
      "default": "./dist/echarts.mjs"
    },
    "./tiptap": {
      "types": "./src/tiptap/index.ts",
      "development": "./src/tiptap/index.ts",
      "production": "./src/tiptap/index.ts",
      "default": "./dist/tiptap.mjs"
    },
    "./vxe-table": {
      "types": "./src/vxe-table/index.ts",
      "development": "./src/vxe-table/index.ts",
      "production": "./src/vxe-table/index.ts",
      "default": "./dist/vxe-table.mjs"
    },
    "./motion": {
      "types": "./src/motion/index.ts",
      "development": "./src/motion/index.ts",
      "production": "./src/motion/index.ts",
      "default": "./dist/motion.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./echarts": {
        "types": "./dist/echarts.d.ts",
        "default": "./dist/echarts.mjs"
      },
      "./tiptap": {
        "types": "./dist/tiptap.d.ts",
        "default": "./dist/tiptap.mjs"
      },
      "./vxe-table": {
        "types": "./dist/vxe-table.d.ts",
        "default": "./dist/vxe-table.mjs"
      },
      "./motion": {
        "types": "./dist/motion.d.ts",
        "default": "./dist/motion.mjs"
      }
    }
  },
  "dependencies": {
    "@describeadmin/core-design": "workspace:*",
    "@describeadmin/core-form-ui": "workspace:*",
    "@describeadmin/core-popup-ui": "workspace:*",
    "@describeadmin/core-shadcn-ui": "workspace:*",
    "@describeadmin/core-shared": "workspace:*",
    "@describeadmin/hooks": "workspace:*",
    "@describeadmin/icons": "workspace:*",
    "@describeadmin/locales": "workspace:*",
    "@describeadmin/preferences": "workspace:*",
    "@describeadmin/types": "workspace:*",
    "@describeadmin/utils": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-highlight": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/extension-underline": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/motion": "catalog:",
    "echarts": "catalog:",
    "vue": "catalog:",
    "vxe-pc-ui": "catalog:",
    "vxe-table": "catalog:"
  },
  "devDependencies": {
    "unplugin-vue": "catalog:"
  }
}
