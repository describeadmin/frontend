    "@describeadmin/core-shadcn-ui": "workspace:*",
    "@describeadmin/core-shared": "workspace:*",
    "@describeadmin/hooks": "workspace:*",
    "@describeadmin/icons": "workspace:*",
    "@describeadmin/locales": "workspace:*",
    "@describeadmin/preferences": "workspace:*",
    "@describeadmin/types": "workspace:*",
    "@describeadmin/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "@vueuse/motion": "catalog:",
    "echarts": "catalog:",
    "vue": "catalog:",
    "vxe-pc-ui": "catalog:",
    "vxe-table": "catalog:"
