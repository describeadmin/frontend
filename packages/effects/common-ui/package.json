{
  "name": "@describeadmin/ui",
  "version": "0.0.1",
  "homepage": "https://github.com/describeadmin/frontend",
  "bugs": "https://github.com/describeadmin/frontend/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/describeadmin/frontend.git",
    "directory": "packages/effects/common-ui"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm exec tsdown",
    "stub": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "production": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./es/tippy": {
      "types": "./src/components/tippy/index.ts",
      "development": "./src/components/tippy/index.ts",
      "production": "./src/components/tippy/index.ts",
      "default": "./dist/es/tippy.mjs"
    },
    "./es/loading": {
      "types": "./src/components/loading/index.ts",
      "development": "./src/components/loading/index.ts",
      "production": "./src/components/loading/index.ts",
      "default": "./dist/es/loading.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./es/tippy": {
        "types": "./dist/es/tippy.d.ts",
        "default": "./dist/es/tippy.mjs"
      },
      "./es/loading": {
        "types": "./dist/es/loading.d.ts",
        "default": "./dist/es/loading.mjs"
      }
    }
  },
  "dependencies": {
    "@describeadmin/constants": "workspace:*",
    "@describeadmin/core-design": "workspace:*",
    "@describeadmin/core-form-ui": "workspace:*",
    "@describeadmin/core-popup-ui": "workspace:*",
    "@describeadmin/core-preferences": "workspace:*",
    "@describeadmin/core-shadcn-ui": "workspace:*",
    "@describeadmin/core-shared": "workspace:*",
    "@describeadmin/hooks": "workspace:*",
    "@describeadmin/icons": "workspace:*",
    "@describeadmin/locales": "workspace:*",
    "@describeadmin/types": "workspace:*",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "json-bigint": "catalog:",
    "qrcode": "catalog:",
    "tippy.js": "catalog:",
    "vue": "catalog:",
    "vue-json-pretty": "catalog:",
    "vue-router": "catalog:",
    "vue-tippy": "catalog:"
  },
  "devDependencies": {
    "@types/json-bigint": "catalog:",
    "@types/qrcode": "catalog:",
    "@vue/test-utils": "catalog:",
    "unplugin-vue": "catalog:"
  }
}
