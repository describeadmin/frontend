# 端口号
VITE_PORT=5777

# 部署子路径，同时作用于静态资源与路由（如部署在 /admin/ 下就写 /admin/）
VITE_BASE=/

# 接口地址。走 vite.config.ts 里的 dev server 代理转发到后端，
# 因此开发期不产生跨域，后端也不需要放开 CORS
VITE_GLOB_API_URL=/api

# dev server 把 /api 代理到哪个后端，默认 http://localhost:8090。
# 也可以临时用环境变量覆盖：VITE_PROXY_TARGET=http://localhost:8091 pnpm dev
# VITE_PROXY_TARGET=http://localhost:8090
