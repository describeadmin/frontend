# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址。走 vite.config.ts 里的 dev server 代理转发到后端，
# 因此开发期不产生跨域，后端也不需要放开 CORS
VITE_GLOB_API_URL=/api

# 不使用 Nitro Mock —— 本项目对接的是真实的 framework-system-starter。
# 用 mock 开发前端，等于把前后端契约不一致的问题全部推迟到联调阶段
VITE_NITRO_MOCK=false

# 是否打开 devtools
VITE_DEVTOOLS=false

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true
