# 应用标题
VITE_APP_TITLE=__PROJECT_NAME__

# 应用命名空间，用于缓存、store 等功能的前缀，确保隔离
VITE_APP_NAMESPACE=__PROJECT_NAME__

# 对 store 进行加密的密钥，在将 store 持久化到 localStorage 时使用
# ⚠️ 部署前请确认这是你自己的密钥，不要与其他项目共用，也不要提交真实值到仓库
# ⚠️ 这是混淆不是防护：密钥会被打进前端产物，任何能在页面里执行脚本的人（XSS）都能解出令牌。
#    它只防"直接翻浏览器存储"这一种看法，令牌安全仍然靠防住 XSS
VITE_APP_STORE_SECURE_KEY=__STORE_SECURE_KEY__
