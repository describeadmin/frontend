# 部署子路径，同时作用于静态资源与路由（如部署在 /admin/ 下就写 /admin/）
VITE_BASE=/

# 接口地址。默认与前端同源，由 Nginx 等把 /api 反代到后端；
# 前后端分域部署时改成后端的完整地址，并同步配置后端的
# describeadmin.security.allowed-origins。
# 构建时会写进产物里的 _app.config.js，部署后改那个文件即可换地址，不用重新打包
VITE_GLOB_API_URL=/api

# vue-router 的模式：history（需要 Nginx 配 try_files 回落到 index.html）或 hash
VITE_ROUTER_HISTORY=history
